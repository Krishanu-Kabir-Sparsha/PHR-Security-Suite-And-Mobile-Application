<?xml version="1.0" encoding="utf-8"?>
<!--
    The three tiers of the Nuclear Key protocol (BRD FR-5).

    Two settings carry the whole sequencing requirement of US-5.2 and are easy
    to lose in a later edit:

      approve_sequence = True         approvals happen in order, not in parallel
      approve_sequence_bypass = False no tier may be skipped

    With approve_sequence False, all three reviewers see the request at once and
    "each tier sees the request only after the prior tier has approved" is
    silently untrue while everything still looks configured.

    Reviewer groups come from the Plaza catalog rather than being hard-coded, so
    changing who holds a tier is a role-catalog decision with its own audit
    trail (P1-7 logs role.plaza_model writes).
-->
<odoo noupdate="1">

    <record id="tier_definition_dept_head" model="tier.definition">
        <field name="name">Override Tier 1 - Department Head</field>
        <field name="model_id" ref="model_override_request"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="sec_plaza_rbac.group_role_dept_head_sales"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[]</field>
        <field name="sequence">10</field>
        <field name="approve_sequence" eval="True"/>
        <field name="approve_sequence_bypass" eval="False"/>
        <field name="has_comment" eval="True"/>
        <field name="notify_on_pending" eval="True"/>
        <field name="notify_on_rejected" eval="True"/>
    </record>

    <record id="tier_definition_compliance" model="tier.definition">
        <field name="name">Override Tier 2 - Compliance / Legal Lead</field>
        <field name="model_id" ref="model_override_request"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="sec_plaza_rbac.group_role_compliance_lead"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[]</field>
        <field name="sequence">20</field>
        <field name="approve_sequence" eval="True"/>
        <field name="approve_sequence_bypass" eval="False"/>
        <field name="has_comment" eval="True"/>
        <field name="notify_on_pending" eval="True"/>
        <field name="notify_on_rejected" eval="True"/>
    </record>

    <record id="tier_definition_ceo" model="tier.definition">
        <field name="name">Override Tier 3 - CEO / Owner (Nuclear Key)</field>
        <field name="model_id" ref="model_override_request"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="sec_plaza_rbac.group_role_ceo_owner"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[]</field>
        <field name="sequence">30</field>
        <field name="approve_sequence" eval="True"/>
        <field name="approve_sequence_bypass" eval="False"/>
        <field name="has_comment" eval="True"/>
        <field name="notify_on_pending" eval="True"/>
        <field name="notify_on_rejected" eval="True"/>
    </record>

</odoo>
