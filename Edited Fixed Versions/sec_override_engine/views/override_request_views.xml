<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_override_request_list" model="ir.ui.view">
        <field name="name">override.request.list</field>
        <field name="model">override.request</field>
        <field name="arch" type="xml">
            <list string="Override Requests"
                  decoration-danger="high_risk and state == 'pending'"
                  decoration-muted="state in ('rejected','cancelled','executed')">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="target_display"/>
                <field name="reason_category_id"/>
                <field name="instruction_type"/>
                <field name="submitted_at"/>
                <field name="validation_status" optional="show"/>
                <field name="high_risk" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_override_request_form" model="ir.ui.view">
        <field name="name">override.request.form</field>
        <field name="model">override.request</field>
        <field name="arch" type="xml">
            <form string="Override Request">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit for Approval" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_execute" type="object"
                            string="Execute Approved Change" class="btn-danger"
                            invisible="state != 'approved'"
                            confirm="This will apply the approved change to the frozen record under a single-use unlock. The record re-freezes immediately afterwards. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft','pending')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved,executed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="High Risk"
                            bg_color="text-bg-danger" invisible="not high_risk"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft'">
                        This request will be reviewed in sequence by the
                        Department Head, then Compliance, then the CEO/Owner.
                        Each sees it only after the previous approval. Write the
                        justification for them.
                    </div>

                    <group>
                        <group string="Target">
                            <field name="res_model"
                                   readonly="state != 'draft'"
                                   placeholder="e.g. sale.order"/>
                            <field name="res_id" readonly="state != 'draft'"/>
                            <field name="target_display"/>
                        </group>
                        <group string="Request">
                            <field name="requester_id"/>
                            <field name="reason_category_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="high_risk"/>
                            <field name="submitted_at"/>
                            <field name="approved_at"/>
                            <field name="executed_at"/>
                            <field name="executed_by_id"/>
                            <field name="unlock_ticket_id"/>
                            <field name="distinct_approver_count"/>
                        </group>
                    </group>

                    <group string="Instruction Provenance">
                        <group>
                            <field name="instruction_type"
                                   readonly="state != 'draft'"/>
                            <field name="instructing_person_id"
                                   readonly="state != 'draft'"
                                   required="instruction_type == 'oral'"/>
                        </group>
                        <group>
                            <field name="documentation_complete"/>
                        </group>
                    </group>

                    <group string="Justification">
                        <field name="justification" nolabel="1"
                               readonly="state != 'draft'"
                               placeholder="What is wrong, what it should say, and why a credit note or amendment will not do."/>
                    </group>

                    <group string="Proposed Changes (description for approvers)">
                        <field name="proposed_changes" nolabel="1"
                               readonly="state != 'draft'"
                               placeholder="Explain the correction in plain language."/>
                    </group>

                    <separator string="Field Changes to Apply"/>
                    <p class="text-muted">
                        Execution applies exactly these fields and nothing else.
                        The unlock is scoped to them, so an approval obtained for
                        one correction cannot be spent on another.
                    </p>
                    <field name="change_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="field_name"/>
                            <field name="field_label" readonly="1"/>
                            <field name="old_value" readonly="1"/>
                            <field name="new_value"/>
                        </list>
                    </field>

                    <group string="Supporting Documentation">
                        <field name="attachment_ids" nolabel="1"
                               readonly="state != 'draft'"
                               widget="many2many_binary"/>
                    </group>

                    <notebook>
                        <page string="Approvals" name="reviews">
                            <field name="review_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="done_by"/>
                                    <field name="reviewed_date"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_override_request_search" model="ir.ui.view">
        <field name="name">override.request.search</field>
        <field name="model">override.request</field>
        <field name="arch" type="xml">
            <search string="Override Requests">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="target_display"/>
                <filter name="filter_pending" string="Awaiting Approval"
                        domain="[('state','=','pending')]"/>
                <filter name="filter_high_risk" string="High Risk"
                        domain="[('high_risk','=',True)]"/>
                <filter name="filter_oral" string="Oral Instruction"
                        domain="[('instruction_type','=','oral')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_category" string="Category"
                            context="{'group_by':'reason_category_id'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by':'state'}"/>
                    <filter name="group_by_requester" string="Requester"
                            context="{'group_by':'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_reason_category_list" model="ir.ui.view">
        <field name="name">override.reason.category.list</field>
        <field name="model">override.reason.category</field>
        <field name="arch" type="xml">
            <list string="Policy Exception Categories">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="requires_attachment"/>
                <field name="high_risk"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_reason_category_form" model="ir.ui.view">
        <field name="name">override.reason.category.form</field>
        <field name="model">override.reason.category</field>
        <field name="arch" type="xml">
            <form string="Policy Exception Category">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="requires_attachment"/>
                            <field name="high_risk"/>
                        </group>
                    </group>
                    <group string="When to Use This">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_override_request" model="ir.actions.act_window">
        <field name="name">Override Requests</field>
        <field name="res_model">override.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_override_request_search"/>
    </record>

    <record id="action_reason_category" model="ir.actions.act_window">
        <field name="name">Policy Exception Categories</field>
        <field name="res_model">override.reason.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_override"
              name="Overrides"
              parent="sec_plaza_rbac.menu_security_suite_root"
              sequence="14"/>

    <menuitem id="menu_override_request"
              name="Override Requests"
              parent="menu_override"
              action="action_override_request"
              sequence="10"/>

    <menuitem id="menu_reason_category"
              name="Policy Exception Categories"
              parent="menu_override"
              action="action_reason_category"
              sequence="20"
              groups="sec_plaza_rbac.group_plaza_compliance"/>

</odoo>
