<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Expired tokens authorise nothing, so keeping them is not evidence, it is
        landfill that grows with every sign-in. Rows still inside their refresh
        window survive even when revoked, so a revocation stays visible for its
        lifetime.
    -->
    <record id="cron_purge_mobile_tokens" model="ir.cron">
        <field name="name">Perfect HR Mobile: purge expired tokens</field>
        <field name="model_id" ref="model_perfecthr_mobile_token"/>
        <field name="state">code</field>
        <field name="code">model.cron_purge_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
