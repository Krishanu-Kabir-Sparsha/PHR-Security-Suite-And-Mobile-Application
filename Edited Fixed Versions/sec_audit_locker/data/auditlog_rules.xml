    </record>

    <record id="rule_plaza_role" model="auditlog.rule">
        <field name="name">Locker: Plaza Role Catalog</field>
        <field name="model_id" ref="sec_plaza_rbac.model_role_plaza_model"/>
        <field name="log_read" eval="False"/>
        <field name="log_create" eval="True"/>
