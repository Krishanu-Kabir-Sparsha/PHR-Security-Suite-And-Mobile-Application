<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_anomaly_dashboard_kanban" model="ir.ui.view">
        <field name="name">anomaly.alert.kanban</field>
        <field name="model">anomaly.alert</field>
        <field name="arch" type="xml">
            <kanban default_group_by="severity" create="false"
                    class="o_kanban_small_column">
                <field name="severity"/>
                <field name="state"/>
                <field name="alert_type"/>
                <field name="locker_entry_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="alert_type"/></div>
                                <div class="text-muted">
                                    <field name="user_id"/> —
                                    <field name="raised_at"/>
                                </div>
                                <div t-if="record.res_model.raw_value" class="text-muted">
                                    <field name="res_model"/>#<field name="res_id"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <span class="badge text-bg-secondary"
                                      t-if="record.locker_entry_count.raw_value">
                                    <field name="locker_entry_count"/> log entries
                                </span>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'new': 'danger', 'reviewed': 'success', 'escalated': 'warning'}}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_anomaly_dashboard_graph" model="ir.ui.view">
        <field name="name">anomaly.alert.graph</field>
        <field name="model">anomaly.alert</field>
        <field name="arch" type="xml">
            <graph string="Anomalies" type="bar" stacked="True">
                <field name="raised_at" interval="day"/>
                <field name="alert_type"/>
            </graph>
        </field>
    </record>

    <record id="view_anomaly_dashboard_pivot" model="ir.ui.view">
        <field name="name">anomaly.alert.pivot</field>
        <field name="model">anomaly.alert</field>
        <field name="arch" type="xml">
            <pivot string="Anomalies">
                <field name="alert_type" type="row"/>
                <field name="severity" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_anomaly_alert_form_links" model="ir.ui.view">
        <field name="name">anomaly.alert.form.links</field>
        <field name="model">anomaly.alert</field>
        <field name="inherit_id" ref="sec_core.view_anomaly_alert_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_target" type="object"
                        string="Open Record" class="btn-secondary"
                        invisible="not target_exists"/>
                <button name="action_open_locker_entries" type="object"
                        string="Audit Trail" class="btn-secondary"
                        invisible="locker_entry_count == 0"/>
                <button name="action_open_override_request" type="object"
                        string="Override Request" class="btn-secondary"
                        invisible="not override_request_id"/>
            </xpath>
            <!--
                Anchored on the field, not on the group's string. Odoo 18
                refuses 'string' as an inheritance selector ("View inheritance
                may not use attribute 'string' as a selector") and it is right
                to: string is translatable, so the same view would stop
                matching under a different language. Field names are not
                translatable, so //field[@name='reason']/.. is stable. It
                selects the group in sec_core.view_anomaly_alert_form that
                wraps the reason field, which is the group we want to precede.
            -->
            <xpath expr="//field[@name='reason']/.." position="before">
                <group string="Evidence">
                    <field name="target_exists" invisible="1"/>
                    <field name="locker_entry_count"/>
                    <field name="override_request_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_surveillance_dashboard" model="ir.actions.act_window">
        <field name="name">Surveillance Dashboard</field>
        <field name="res_model">anomaly.alert</field>
        <field name="view_mode">kanban,list,graph,pivot,form</field>
        <field name="search_view_id" ref="sec_core.view_anomaly_alert_search"/>
        <field name="context">{'search_default_filter_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing flagged</p>
            <p>
                An empty dashboard means no anomalies have been raised, not that
                surveillance is off. Use Check Surveillance Configuration to
                confirm business hours and timezone are set for your
                organisation.
            </p>
        </field>
    </record>

    <menuitem id="menu_surveillance_dashboard"
              name="Dashboard"
              parent="sec_core.menu_surveillance"
              action="action_surveillance_dashboard"
              sequence="5"/>

</odoo>
