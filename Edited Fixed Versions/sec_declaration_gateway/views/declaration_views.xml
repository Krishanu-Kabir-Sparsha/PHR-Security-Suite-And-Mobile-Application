<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_declaration_version_list" model="ir.ui.view">
        <field name="name">declaration.version.list</field>
        <field name="model">declaration.version</field>
        <field name="arch" type="xml">
            <list string="Declaration Versions" decoration-success="state == 'published'">
                <field name="version"/>
                <field name="name"/>
                <field name="effective_date"/>
                <field name="approved_by_legal"/>
                <field name="signoff_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_declaration_version_form" model="ir.ui.view">
        <field name="name">declaration.version.form</field>
        <field name="model">declaration.version</field>
        <field name="arch" type="xml">
            <form string="Declaration Version">
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Publishing forces every active user to accept this declaration before they can reach the dashboard. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,superseded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="version" placeholder="e.g. 1.0"/></h3>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Declaration wording is supplied by Legal Counsel. Engineering
                        does not author this text, and it cannot be published until
                        Legal approval is recorded below.
                    </div>
                    <group>
                        <group>
                            <field name="effective_date"/>
                            <field name="is_material_update"/>
                        </group>
                        <group>
                            <field name="approved_by_legal"/>
                            <field name="legal_reviewer"
                                   required="approved_by_legal"/>
                            <field name="text_hash"/>
                            <field name="signoff_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Declaration Text (English)" name="body_en">
                            <field name="body_html" widget="html"/>
                        </page>
                        <page string="Declaration Text (Bengali)" name="body_bn">
                            <field name="body_html_bn" widget="html"/>
                        </page>
                        <page string="Sign-offs" name="signoffs">
                            <field name="signoff_ids" readonly="1">
                                <list>
                                    <field name="user_id"/>
                                    <field name="accepted_at"/>
                                    <field name="source_ip"/>
                                    <field name="hash_matches_version"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_declaration_signoff_list" model="ir.ui.view">
        <field name="name">declaration.signoff.list</field>
        <field name="model">declaration.signoff</field>
        <field name="arch" type="xml">
            <list string="Declaration Sign-offs" create="false"
                  decoration-danger="not hash_matches_version">
                <field name="user_id"/>
                <field name="declaration_version"/>
                <field name="accepted_at"/>
                <field name="source_ip"/>
                <field name="hash_matches_version"/>
            </list>
        </field>
    </record>

    <record id="action_declaration_version" model="ir.actions.act_window">
        <field name="name">Declaration Versions</field>
        <field name="res_model">declaration.version</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_declaration_signoff" model="ir.actions.act_window">
        <field name="name">Declaration Sign-offs</field>
        <field name="res_model">declaration.signoff</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_declaration"
              name="Declaration"
              parent="sec_plaza_rbac.menu_security_suite_root"
              sequence="5"
              groups="sec_plaza_rbac.group_plaza_compliance"/>

    <menuitem id="menu_declaration_version"
              name="Versions"
              parent="menu_declaration"
              action="action_declaration_version"
              sequence="10"/>

    <menuitem id="menu_declaration_signoff"
              name="Sign-off Register"
              parent="menu_declaration"
              action="action_declaration_signoff"
              sequence="20"/>

</odoo>
