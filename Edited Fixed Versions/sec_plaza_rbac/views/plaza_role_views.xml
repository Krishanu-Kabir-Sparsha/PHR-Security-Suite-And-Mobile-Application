<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_plaza_role_list" model="ir.ui.view">
        <field name="name">role.plaza_model.list</field>
        <field name="model">role.plaza_model</field>
        <field name="arch" type="xml">
            <!-- decoration-warning marks a role whose Access Matrix claims
                 permissions the backing group does not confer. Visible from
                 the catalog list so the gap is found during a review rather
                 than when somebody cannot do their job. -->
            <list string="Plaza Model Role Catalog" default_order="sequence,code"
                  decoration-warning="grants_nothing">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_approval_tier"/>
                <field name="group_id"/>
                <field name="access_line_count"/>
                <field name="user_count"/>
                <field name="grants_nothing" string="Grants nothing" optional="show"/>
                <field name="requires_webauthn" optional="show"/>
                <field name="catalog_version" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_plaza_role_form" model="ir.ui.view">
        <field name="name">role.plaza_model.form</field>
        <field name="model">role.plaza_model</field>
        <field name="arch" type="xml">
            <form string="Plaza Model Role">
                <header>
                    <button name="action_view_users"
                            type="object"
                            string="View Assigned Users"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Line Manager"/></h1>
                        <h3><field name="code" placeholder="e.g. HR_LINE_MANAGER"/></h3>
                    </div>
                    <group>
                        <group string="This Role">
                            <field name="active" invisible="1"/>
                            <field name="sequence" invisible="1"/>
                            <field name="catalog_version" invisible="1"/>
                            <!-- Technical, and only ever set by the system.
                                 Left visible in developer mode for support, and
                                 out of the way otherwise: it is not a decision
                                 anybody configuring a role has to make. -->
                            <field name="group_id" groups="base.group_no_one"/>
                            <field name="user_count"/>
                        </group>
                        <group string="Approvals">
                            <field name="is_approval_tier"/>
                            <field name="requires_webauthn"/>
                        </group>
                    </group>
                    <group string="What this role is for">
                        <field name="description"
                               nolabel="1"
                               placeholder="What this role is for, and the boundaries of what it may do."/>
                    </group>
                    <notebook>
                        <!--
                          One tab, one row per area, one choice per row.

                          What used to be here asked for a module, a record
                          type, four permission checkboxes, a transaction class
                          and a capability: seven decisions, six of them
                          mechanical consequences of the first, and all of them
                          able to contradict one another. They still exist on
                          the record because the segregation-of-duties scan and
                          the mobile app read them; they are simply derived now.
                        -->
                        <page string="Permissions" name="permissions">
                            <field name="access_line_ids">
                                <list editable="bottom">
                                    <field name="area"/>
                                    <field name="access_level"/>
                                    <field name="notes"
                                           string="Why"
                                           placeholder="Reason, for the monthly review"/>
                                    <field name="field_restrictions"
                                           optional="hide"/>
                                    <!-- Derived. Visible in developer mode only,
                                         so support can see what a line resolved
                                         to without it becoming another thing to
                                         fill in. -->
                                    <field name="transaction_type"
                                           groups="base.group_no_one"
                                           optional="hide"/>
                                    <field name="capability"
                                           groups="base.group_no_one"
                                           optional="hide"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                A role may either submit work or approve it,
                                never both for the same area. That is what makes
                                an approval mean something, and it is enforced
                                when the role is saved. Conflicts that arise from
                                one person holding several roles are found by the
                                segregation-of-duties scan instead.
                            </div>
                            <div class="alert alert-info mt-2" role="status"
                                 invisible="not granted_summary">
                                <strong>This role gives access to:</strong>
                                <field name="granted_summary" nolabel="1" readonly="1"/>
                            </div>
                            <div class="alert alert-warning mt-2" role="alert"
                                 invisible="not grants_nothing">
                                <strong>This role grants nothing yet.</strong>
                                Its permissions are set, but none of them confer
                                access in Perfect HR. Save the role to apply
                                them, or ask an administrator if this persists.
                            </div>
                            <field name="grants_nothing" invisible="1"/>
                        </page>
                        <page string="People" name="users">
                            <div class="alert alert-info" role="status">
                                Adding someone here gives them everything on the
                                Permissions tab.
                            </div>
                            <field name="user_ids">
                                <list editable="bottom">
                                    <field name="login"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_plaza_role_search" model="ir.ui.view">
        <field name="name">role.plaza_model.search</field>
        <field name="model">role.plaza_model</field>
        <field name="arch" type="xml">
            <search string="Plaza Roles">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="filter_approvers" string="Approval Tiers"
                        domain="[('is_approval_tier','!=','none')]"/>
                <filter name="filter_no_group" string="No Backing Group"
                        domain="[('group_id','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_tier" string="Approval Tier"
                            context="{'group_by':'is_approval_tier'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_plaza_role" model="ir.actions.act_window">
        <field name="name">Plaza Model Role Catalog</field>
        <field name="res_model">role.plaza_model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_plaza_role_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the Plaza Model role catalog</p>
            <p>
                The catalog holds between 10 and 20 active roles, each with a
                mandatory description and an explicit module/field access matrix.
            </p>
        </field>
    </record>

</odoo>
