<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_plaza_role_list" model="ir.ui.view">
        <field name="name">role.plaza_model.list</field>
        <field name="model">role.plaza_model</field>
        <field name="arch" type="xml">
            <list string="Plaza Model Role Catalog" default_order="sequence,code">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_approval_tier"/>
                <field name="group_id"/>
                <field name="access_line_count"/>
                <field name="user_count"/>
                <field name="requires_webauthn" optional="show"/>
                <field name="catalog_version" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_plaza_role_form" model="ir.ui.view">
        <field name="name">role.plaza_model.form</field>
        <field name="model">role.plaza_model</field>
        <field name="arch" type="xml">
            <form string="Plaza Model Role">
                <header>
                    <button name="action_view_users"
                            type="object"
                            string="View Assigned Users"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <!--
                        No warning banner and no button: a role now always gets
                        a backing group, on create and again on first
                        assignment if one is somehow missing. The empty state
                        that this used to warn about is no longer reachable
                        through normal use.
                    -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Accounting Lead"/></h1>
                        <h3><field name="code" placeholder="e.g. ACC_LEAD"/></h3>
                    </div>
                    <group>
                        <group string="Definition">
                            <field name="active" invisible="1"/>
                            <field name="sequence"/>
                            <field name="group_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="catalog_version"/>
                        </group>
                        <group string="Authorisation Role">
                            <field name="is_approval_tier"/>
                            <field name="requires_webauthn"/>
                            <field name="user_count"/>
                        </group>
                    </group>
                    <group string="Description (mandatory)">
                        <field name="description"
                               nolabel="1"
                               placeholder="What this role is for, and the boundaries of what it may do."/>
                    </group>
                    <notebook>
                        <page string="Access Matrix" name="access_matrix">
                            <field name="access_line_ids">
                                <list editable="bottom">
                                    <!-- allowed_model_ids drives the Model
                                         domain. It has to be in the arch for
                                         the client to evaluate that domain,
                                         hence column_invisible. -->
                                    <field name="allowed_model_ids"
                                           column_invisible="1"/>
                                    <!-- plaza_show_technical_name renders
                                         "Sales (sale)" instead of "Sales".
                                         Two installed modules share the label
                                         "Sales"; see models/ir_module_module.py. -->
                                    <field name="module_id"
                                           context="{'plaza_show_technical_name': True}"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="model_id"
                                           domain="[('id', 'in', allowed_model_ids)]"
                                           options="{'no_create': True, 'no_open': True}"
                                           placeholder="Select a module first"/>
                                    <!-- The stored technical values. Hidden by
                                         default because the pickers above are
                                         the working fields, but available from
                                         the optional-columns menu: model_name
                                         is what the SoD report and the seeded
                                         catalog actually key on, so being able
                                         to see it matters during review. -->
                                    <field name="module_label" optional="hide"/>
                                    <field name="model_name" optional="hide"/>
                                    <field name="perm_read"/>
                                    <field name="perm_create"/>
                                    <field name="perm_write"/>
                                    <field name="perm_unlink"/>
                                    <field name="transaction_type"/>
                                    <field name="capability"/>
                                    <field name="field_restrictions"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2">
                                A single role may never carry both Create and Approve
                                on the same transaction class. Conflicts arising from a
                                <em>combination</em> of roles are detected by the
                                segregation-of-duties scan.
                            </p>
                        </page>
                        <page string="Assigned Users" name="users">
                            <!--
                                Editable, but still derived: the inverse writes
                                res.users.groups_id rather than group.users, so
                                the non-standard-grant guard in ResUsers.write
                                still runs. See _inverse_user_ids.
                            -->
                            <div class="alert alert-info" role="alert">
                                Adding or removing someone here changes their
                                membership of this role's Backing Security
                                Group. It requires permission to administer
                                users.
                            </div>
                            <field name="user_ids"
                                   options="{'no_create': True}">
                                <list>
                                    <field name="login"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_plaza_role_search" model="ir.ui.view">
        <field name="name">role.plaza_model.search</field>
        <field name="model">role.plaza_model</field>
        <field name="arch" type="xml">
            <search string="Plaza Roles">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="filter_approvers" string="Approval Tiers"
                        domain="[('is_approval_tier','!=','none')]"/>
                <filter name="filter_no_group" string="No Backing Group"
                        domain="[('group_id','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_tier" string="Approval Tier"
                            context="{'group_by':'is_approval_tier'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_plaza_role" model="ir.actions.act_window">
        <field name="name">Plaza Model Role Catalog</field>
        <field name="res_model">role.plaza_model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_plaza_role_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the Plaza Model role catalog</p>
            <p>
                The catalog holds between 10 and 20 active roles, each with a
                mandatory description and an explicit module/field access matrix.
            </p>
        </field>
    </record>

</odoo>
