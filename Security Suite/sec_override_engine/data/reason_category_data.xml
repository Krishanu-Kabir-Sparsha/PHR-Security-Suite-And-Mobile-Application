<?xml version="1.0" encoding="utf-8"?>
<!--
    Recognised policy exception categories (US-5.1).

    noupdate="1": the organisation will tune this list, and an upgrade must not
    silently reintroduce a category Compliance deliberately retired.

    The list is deliberately short. A long list is indistinguishable from free
    text: people pick whichever entry is nearest and the resulting statistics
    mean nothing.
-->
<odoo noupdate="1">

    <record id="seq_override_request" model="ir.sequence">
        <field name="name">Override Requests</field>
        <field name="code">override.request</field>
        <field name="prefix">OVR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="reason_data_entry_error" model="override.reason.category">
        <field name="name">Data Entry Correction</field>
        <field name="code">DATA_ENTRY</field>
        <field name="sequence">10</field>
        <field name="description">A value was keyed incorrectly and the error is demonstrable from source documentation — for example an amount entered as 10,000 instead of 1,000. The BRD's worked example. Requires the source document showing the correct figure.</field>
        <field name="requires_attachment" eval="True"/>
    </record>

    <record id="reason_refund_policy" model="override.reason.category">
        <field name="name">Refund Policy Exception</field>
        <field name="code">REFUND</field>
        <field name="sequence">20</field>
        <field name="description">A refund or credit outside standard policy terms, agreed with the customer. Use only where a credit note cannot achieve the same outcome.</field>
        <field name="requires_attachment" eval="True"/>
        <field name="high_risk" eval="True"/>
    </record>

    <record id="reason_pricing_correction" model="override.reason.category">
        <field name="name">Pricing or Discount Correction</field>
        <field name="code">PRICING</field>
        <field name="sequence">30</field>
        <field name="description">An agreed price or discount was not applied correctly at confirmation. Requires the agreement evidencing the correct terms.</field>
        <field name="requires_attachment" eval="True"/>
        <field name="high_risk" eval="True"/>
    </record>

    <record id="reason_counterparty_correction" model="override.reason.category">
        <field name="name">Counterparty Correction</field>
        <field name="code">COUNTERPARTY</field>
        <field name="sequence">40</field>
        <field name="description">The document was raised against the wrong customer or vendor. High risk: changing the counterparty on a confirmed document changes who owes whom.</field>
        <field name="requires_attachment" eval="True"/>
        <field name="high_risk" eval="True"/>
    </record>

    <record id="reason_regulatory" model="override.reason.category">
        <field name="name">Regulatory or Tax Correction</field>
        <field name="code">REGULATORY</field>
        <field name="sequence">50</field>
        <field name="description">A change required to comply with a tax or regulatory determination, including a correction directed by an auditor or authority. Attach the determination.</field>
        <field name="requires_attachment" eval="True"/>
    </record>

    <record id="reason_system_error" model="override.reason.category">
        <field name="name">System or Integration Error</field>
        <field name="code">SYSTEM</field>
        <field name="sequence">60</field>
        <field name="description">The record is wrong because of a defect or a failed integration, not a human decision. Attach the incident reference. A rising count here is a signal to fix the system rather than to keep approving overrides.</field>
        <field name="requires_attachment" eval="True"/>
    </record>

</odoo>
