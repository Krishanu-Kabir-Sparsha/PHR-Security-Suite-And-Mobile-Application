<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_anomaly_review_wizard_form" model="ir.ui.view">
        <field name="name">anomaly.review.wizard.form</field>
        <field name="model">anomaly.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Anomalies">
                <field name="alert_ids" invisible="1"/>
                <field name="contains_severe" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="alert_count &lt; 2">
                    You are reviewing <field name="alert_count" class="oe_inline"/>
                    alerts with one note. Each will be recorded as a bulk review,
                    which the monthly report distinguishes from individually
                    considered ones.
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="not contains_severe or alert_count &lt; 2">
                    The selection includes high or critical alerts. Those must be
                    reviewed individually.
                </div>
                <group>
                    <field name="outcome"/>
                </group>
                <group string="Note (mandatory)">
                    <field name="note" nolabel="1"
                           placeholder="What was checked and what was concluded. This is applied to every selected alert, so it must be true of all of them."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Record Review"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_anomaly_review_wizard" model="ir.actions.act_window">
        <field name="name">Review Anomalies</field>
        <field name="res_model">anomaly.review.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sec_core.model_anomaly_alert"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="context">{'default_alert_ids': active_ids}</field>
    </record>

</odoo>
