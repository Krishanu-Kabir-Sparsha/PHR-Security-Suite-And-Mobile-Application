<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_value_threshold_list" model="ir.ui.view">
        <field name="name">sec.value.threshold.list</field>
        <field name="model">sec.value.threshold</field>
        <field name="arch" type="xml">
            <list string="High-Value Thresholds" editable="bottom"
                  decoration-warning="not owner_id">
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="comparison_mode"/>
                <field name="threshold_amount"/>
                <field name="severity"/>
                <field name="owner_id"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_value_threshold_form" model="ir.ui.view">
        <field name="name">sec.value.threshold.form</field>
        <field name="model">sec.value.threshold</field>
        <field name="arch" type="xml">
            <form string="High-Value Threshold">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="model_name" placeholder="account.move"/>
                            <field name="field_name" placeholder="amount_total"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="comparison_mode"/>
                            <field name="threshold_amount"/>
                            <field name="severity"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <group string="Rationale">
                        <field name="notes" nolabel="1"
                               placeholder="Why this figure, and what a reviewer should do when it fires."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Thresholds are compared against the value as stored on the
                        field. In a multi-currency setup, a figure stored in a
                        foreign currency is not converted before comparison — set
                        per-field thresholds accordingly, or watch the
                        company-currency field instead.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_value_threshold" model="ir.actions.act_window">
        <field name="name">High-Value Thresholds</field>
        <field name="res_model">sec.value.threshold</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No thresholds configured</p>
            <p>
                While this list is empty, no edit will ever be flagged on value.
                The figures are a business decision (PRD Section 12) and are
                deliberately not shipped with defaults — an invented number
                would look like a considered decision nobody made.
            </p>
        </field>
    </record>

    <menuitem id="menu_value_threshold"
              name="High-Value Thresholds"
              parent="sec_core.menu_surveillance"
              action="action_value_threshold"
              sequence="20"
              groups="sec_plaza_rbac.group_plaza_compliance"/>

</odoo>
