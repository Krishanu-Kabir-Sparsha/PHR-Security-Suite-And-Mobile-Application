<?xml version="1.0" encoding="utf-8"?>
<!--
    Out-of-hours detection settings.

    The timezone is deliberately left EMPTY so the code falls back to the
    company's own timezone. Hard-coding a default here would silently flag an
    entire workday in any organisation that is not in that zone, and the
    dashboard would be written off as noisy in its first week.
-->
<odoo noupdate="1">

    <record id="param_out_of_hours_enabled" model="ir.config_parameter">
        <field name="key">sec_surveillance.out_of_hours_enabled</field>
        <field name="value">True</field>
    </record>

    <record id="param_business_start" model="ir.config_parameter">
        <field name="key">sec_surveillance.business_start_hour</field>
        <field name="value">9</field>
    </record>

    <record id="param_business_end" model="ir.config_parameter">
        <field name="key">sec_surveillance.business_end_hour</field>
        <field name="value">18</field>
    </record>

    <!-- ISO weekdays, Monday = 1. Organisations with a Sunday-Thursday week
         must change this; leaving Mon-Fri would flag two normal working days
         and clear two weekend days. -->
    <record id="param_working_days" model="ir.config_parameter">
        <field name="key">sec_surveillance.working_days</field>
        <field name="value">1,2,3,4,5</field>
    </record>

    <record id="param_timezone" model="ir.config_parameter">
        <field name="key">sec_surveillance.timezone</field>
        <field name="value"></field>
    </record>

</odoo>
