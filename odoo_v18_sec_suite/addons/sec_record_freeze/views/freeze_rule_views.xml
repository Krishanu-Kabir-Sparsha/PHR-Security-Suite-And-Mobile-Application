<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_freeze_rule_list" model="ir.ui.view">
        <field name="name">sec.freeze.rule.list</field>
        <field name="model">sec.freeze.rule</field>
        <field name="arch" type="xml">
            <list string="Record Freeze Rules" decoration-danger="not enforcement_active">
                <field name="name"/>
                <field name="model_name"/>
                <field name="stream"/>
                <field name="frozen_states"/>
                <field name="block_unlink"/>
                <field name="enforcement_active"/>
            </list>
        </field>
    </record>

    <record id="view_freeze_rule_form" model="ir.ui.view">
        <field name="name">sec.freeze.rule.form</field>
        <field name="model">sec.freeze.rule</field>
        <field name="arch" type="xml">
            <form string="Record Freeze Rule">
                <sheet>
                    <widget name="web_ribbon" title="Enforcement Off"
                            bg_color="text-bg-danger" invisible="enforcement_active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="enforcement_active">
                        Enforcement is switched off for this model. Confirmed records
                        can currently be edited without an override. Switching this
                        off raises a critical anomaly alert.
                    </div>
                    <group>
                        <group>
                            <field name="model_name"/>
                            <field name="stream"/>
                            <field name="state_field_path"/>
                            <field name="frozen_states"
                                   placeholder="e.g. sale,done"/>
                        </group>
                        <group>
                            <field name="block_unlink"/>
                            <field name="enforcement_active"/>
                        </group>
                    </group>
                    <group string="Protected Fields">
                        <field name="protected_fields" nolabel="1"
                               placeholder="Comma-separated. Fields NOT listed here stay writable on a frozen record."/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freeze_rule" model="ir.actions.act_window">
        <field name="name">Record Freeze Rules</field>
        <field name="res_model">sec.freeze.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_record_freeze"
              name="Record Freeze"
              parent="sec_plaza_rbac.menu_security_suite_root"
              sequence="12"
              groups="sec_plaza_rbac.group_plaza_viewer"/>

    <menuitem id="menu_freeze_rule"
              name="Freeze Rules"
              parent="menu_record_freeze"
              action="action_freeze_rule"
              sequence="10"/>

</odoo>
