<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stream_lock_list" model="ir.ui.view">
        <field name="name">sec.stream.lock.list</field>
        <field name="model">sec.stream.lock</field>
        <field name="arch" type="xml">
            <list string="Back-end Stream Locks" create="false" delete="false"
                  decoration-danger="locked">
                <field name="stream"/>
                <field name="locked"/>
                <field name="locked_by_id"/>
                <field name="locked_at"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_stream_lock_form" model="ir.ui.view">
        <field name="name">sec.stream.lock.form</field>
        <field name="model">sec.stream.lock</field>
        <field name="arch" type="xml">
            <form string="Back-end Stream Lock" create="false" delete="false">
                <header>
                    <button name="%(action_stream_lock_wizard)d" type="action"
                            string="Lock Stream" class="btn-danger"
                            invisible="locked"
                            context="{'default_lock_id': id, 'default_target_state': 'lock'}"/>
                    <button name="%(action_stream_lock_wizard)d" type="action"
                            string="Release Lock" class="btn-primary"
                            invisible="not locked"
                            context="{'default_lock_id': id, 'default_target_state': 'unlock'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="LOCKED"
                            bg_color="text-bg-danger" invisible="not locked"/>
                    <div class="oe_title">
                        <h1><field name="stream" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="locked">
                        Locking a stream stops <strong>all</strong> creation, editing and
                        deletion in it, in every state, for every user except a Super
                        Administrator. Scheduled jobs touching this stream will also
                        fail while the lock is engaged. This is a lockdown switch, not
                        a routine setting.
                    </div>
                    <group>
                        <group>
                            <field name="locked"/>
                            <field name="locked_by_id"/>
                            <field name="locked_at"/>
                        </group>
                    </group>
                    <group string="Current Reason">
                        <field name="reason" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Toggle History" name="history">
                            <field name="log_ids" readonly="1">
                                <list decoration-warning="not strongly_authenticated">
                                    <field name="changed_at"/>
                                    <field name="actor_id"/>
                                    <field name="state_before"/>
                                    <field name="state_after"/>
                                    <field name="strongly_authenticated"/>
                                    <field name="source_ip"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stream_lock_wizard_form" model="ir.ui.view">
        <field name="name">sec.stream.lock.wizard.form</field>
        <field name="model">sec.stream.lock.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Stream Lock Change">
                <group>
                    <field name="lock_id" readonly="1"/>
                    <field name="target_state" readonly="1"/>
                </group>
                <group string="Reason (mandatory)">
                    <field name="reason" nolabel="1"
                           placeholder="Why this stream is being locked or released. This appears in the monthly forensic report."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stream_lock_wizard" model="ir.actions.act_window">
        <field name="name">Confirm Stream Lock Change</field>
        <field name="res_model">sec.stream.lock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_stream_lock" model="ir.actions.act_window">
        <field name="name">Back-end Stream Locks</field>
        <field name="res_model">sec.stream.lock</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stream_lock"
              name="Back-end Locks"
              parent="menu_record_freeze"
              action="action_stream_lock"
              sequence="20"/>

</odoo>
