<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_replica_target_list" model="ir.ui.view">
        <field name="name">audit.replica.target.list</field>
        <field name="model">audit.replica.target</field>
        <field name="arch" type="xml">
            <list string="Replication Targets" decoration-danger="last_error">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="target_type"/>
                <field name="independent_custodian"/>
                <field name="last_success_at"/>
                <field name="entries_shipped"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_replica_target_form" model="ir.ui.view">
        <field name="name">audit.replica.target.form</field>
        <field name="model">audit.replica.target</field>
        <field name="arch" type="xml">
            <form string="Replication Target">
                <header>
                    <button name="action_test" type="object"
                            string="Test Target" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="alert">
                        This control only works if the target is administered by
                        someone other than the application DBA (BRD Section 8.2).
                        A file on this host, written by this service account,
                        protects against a bad UPDATE and nothing else. Record
                        the custodian below, and confirm with them that they hold
                        it independently.
                    </div>
                    <group>
                        <group>
                            <field name="target_type"/>
                            <field name="active"/>
                            <field name="independent_custodian"
                                   placeholder="Name and role of whoever controls this store"/>
                        </group>
                        <group>
                            <field name="last_success_at"/>
                            <field name="entries_shipped"/>
                            <field name="last_error_at"/>
                        </group>
                    </group>
                    <group string="Append-only file"
                           invisible="target_type != 'append_file'">
                        <field name="file_path" nolabel="1"
                               placeholder="/mnt/audit-replica/locker.jsonl"/>
                    </group>
                    <group string="HTTPS endpoint" invisible="target_type != 'http'">
                        <field name="endpoint_url" placeholder="https://audit.example.com/locker"/>
                        <field name="shared_secret" password="True"/>
                        <field name="timeout_seconds"/>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_replica_target" model="ir.actions.act_window">
        <field name="name">Replication Targets</field>
        <field name="res_model">audit.replica.target</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No replication target configured</p>
            <p>
                Until one exists, the audit trail lives only in the primary
                database and BRD FR-4.3 is not met. The hash chain makes
                tampering detectable; it does not make the evidence survive
                deletion.
            </p>
        </field>
    </record>

    <record id="action_replicate_now" model="ir.actions.server">
        <field name="name">Replicate Locker Now</field>
        <field name="model_id" ref="model_audit_locker_entry"/>
        <field name="state">code</field>
        <field name="code">
result = model.replicate_pending()
status = model.replication_status()
raise UserWarning("Shipped %s entry(ies). %s" % (result.get("shipped", 0), status.get("message")))
        </field>
    </record>

    <menuitem id="menu_replica_target"
              name="Replication Targets"
              parent="menu_locker"
              action="action_replica_target"
              sequence="30"
              groups="sec_plaza_rbac.group_security_super_admin"/>

    <menuitem id="menu_replicate_now"
              name="Replicate Now"
              parent="menu_locker"
              action="action_replicate_now"
              sequence="40"
              groups="sec_plaza_rbac.group_plaza_compliance"/>

</odoo>
