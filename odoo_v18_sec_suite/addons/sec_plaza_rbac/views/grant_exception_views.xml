<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_grant_exception_list" model="ir.ui.view">
        <field name="name">plaza.grant.exception.list</field>
        <field name="model">plaza.grant.exception</field>
        <field name="arch" type="xml">
            <list string="Non-Standard Permission Grants" decoration-warning="state == 'approved'">
                <field name="user_id"/>
                <field name="group_id"/>
                <field name="requested_by_id"/>
                <field name="approved_by_id"/>
                <field name="expires_on"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_grant_exception_form" model="ir.ui.view">
        <field name="name">plaza.grant.exception.form</field>
        <field name="model">plaza.grant.exception</field>
        <field name="arch" type="xml">
            <form string="Non-Standard Permission Grant Exception">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            class="btn-secondary" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,revoked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="group_id"/>
                            <field name="expires_on"/>
                        </group>
                        <group>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="approved_on"/>
                            <field name="flagged_for_audit"/>
                        </group>
                    </group>
                    <group string="Justification (mandatory)">
                        <field name="justification" nolabel="1"
                               placeholder="Why no standard Plaza role covers this need."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_grant_exception" model="ir.actions.act_window">
        <field name="name">Grant Exceptions</field>
        <field name="res_model">plaza.grant.exception</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
